{
  "name": "@tychilabs/react-ugf",
  "version": "0.0.1",
  "description": "UGF gasless payment component for React — let users pay gas in stablecoins across EVM chains",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean"
  },
  "peerDependencies": {
    "ethers": "^6",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "@tychilabs/ugf-sdk": "^2.0.23"
  },
  "keywords": [
    "ugf",
    "react",
    "gasless",
    "gas-abstraction",
    "web3",
    "stablecoin",
    "usdc",
    "multichain"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TychiWallet/react-ugf"
  },
  "homepage": "https://universalgasframework.com",
  "bugs": {
    "url": "https://github.com/TychiWallet/react-ugf/issues"
  },
  "sideEffects": false,
  "license": "Apache-2.0"
}
