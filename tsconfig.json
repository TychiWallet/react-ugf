{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "ignoreDeprecations": "6.0",
    "declaration": true,
    "rootDir": "./src",
    "outDir": "dist",
    "skipLibCheck": true
  },
  "include": ["src", "src/core/.ts"]
}
